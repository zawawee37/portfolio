---
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource-variable/noto-sans-thai";
import "../styles/global.css";
import type { Locale, SiteContent } from "../content/site";

interface Props {
  locale: Locale;
  content: SiteContent;
  pageType?: "home" | "not-found";
}

const { locale, content, pageType = "home" } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://portfolio.infratest.click");
const canonicalPath = pageType === "home" ? (locale === "th" ? "/th/" : "/") : Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const englishUrl = new URL("/", siteUrl);
const thaiUrl = new URL("/th/", siteUrl);
const ogImage = new URL("/images/og-cover.png", siteUrl);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sawawee Sareh-esor",
  url: englishUrl.toString(),
  image: ogImage.toString(),
  jobTitle: "Senior Cloud Platform & Infrastructure Engineer",
  email: "mailto:zawawee37@gmail.com",
  telephone: "+66 92-799-4723",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bangkok",
    addressCountry: "TH",
  },
  sameAs: [
    "https://www.linkedin.com/in/sawawee-sarehesor-esor-0883b8b2/",
    "https://github.com/zawawee37",
  ],
  knowsAbout: [
    "AWS",
    "Microsoft Azure",
    "Cloud Infrastructure",
    "Platform Engineering",
    "DevSecOps",
    "Terraform",
    "Kubernetes",
    "Hybrid Cloud",
  ],
};
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071014" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={content.seo.description} />
    <meta name="author" content="Sawawee Sareh-esor" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="th" href={thaiUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Sawawee Sareh-esor" />
    <meta property="og:title" content={content.seo.title} />
    <meta property="og:description" content={content.seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1536" />
    <meta property="og:image:alt" content={content.hero.imageAlt} />
    <meta property="og:locale" content={locale === "th" ? "th_TH" : "en_US"} />
    <meta property="profile:first_name" content="Sawawee" />
    <meta property="profile:last_name" content="Sareh-esor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.seo.title} />
    <meta name="twitter:description" content={content.seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{content.seo.title}</title>
    {pageType === "home" && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "th" ? "ข้ามไปยังเนื้อหา" : "Skip to content"}</a>
    <slot />
  </body>
</html>
