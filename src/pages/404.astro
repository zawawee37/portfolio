---
import { siteContent } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const content = siteContent.en;
---

<BaseLayout locale="en" content={content} pageType="not-found">
  <main id="main-content" class="not-found">
    <p class="eyebrow">404 · Route not found</p>
    <h1>This path is outside the platform.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a class="button button-primary" href="/"><span>Return home</span><span aria-hidden="true">↗</span></a>
  </main>
</BaseLayout>
